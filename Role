<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Belbin Team Roles Questionnaire</title>

<style>
:root{
  --navy:#173b63;
  --blue:#2b6fa6;
  --blue2:#4b8ec2;
  --pale:#eef5fb;
  --line:#d8e2eb;
  --text:#1e293b;
  --muted:#64748b;
  --good:#18794e;
  --bad:#b42318;
  --white:#fff;
  --shadow:0 10px 30px rgba(22,59,99,.08);
  --shadow-sm:0 4px 14px rgba(22,59,99,.06);
}

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  font-family:Inter,"Segoe UI",Arial,sans-serif;
  background:linear-gradient(180deg,#f4f8fb 0,#f8fafc 320px,#f5f7fa 100%);
  color:var(--text);
  line-height:1.5;
}

.shell{
  max-width:1120px;
  margin:0 auto;
  padding:30px 20px 60px;
}

.hero{
  position:relative;
  overflow:hidden;
  background:linear-gradient(135deg,#15395f 0%,#215985 60%,#2b6fa6 100%);
  color:#fff;
  border-radius:22px;
  padding:34px 36px 30px;
  box-shadow:0 16px 40px rgba(22,59,99,.16);
}

.hero:after{
  content:"";
  position:absolute;
  width:280px;
  height:280px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:50%;
  right:-90px;
  top:-110px;
  box-shadow:
    0 0 0 42px rgba(255,255,255,.035),
    0 0 0 84px rgba(255,255,255,.025);
}

.hero-title{
  display:flex;
  gap:16px;
  align-items:center;
  position:relative;
  z-index:1;
}

.hero-icon{
  width:56px;
  height:56px;
  border-radius:15px;
  background:rgba(255,255,255,.13);
  border:1px solid rgba(255,255,255,.2);
  display:grid;
  place-items:center;
  flex:0 0 auto;
}

.hero-icon svg{
  width:30px;
  height:30px;
  stroke:#fff;
  fill:none;
  stroke-width:1.8;
}

.hero h1{
  margin:0 0 6px;
  font-size:clamp(1.8rem,3vw,2.55rem);
  letter-spacing:-.02em;
}

.hero p{
  margin:0;
  max-width:820px;
  color:#e7f1f8;
}

.hero-stats{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:22px;
  position:relative;
  z-index:1;
}

.stat-pill{
  display:flex;
  align-items:center;
  gap:8px;
  padding:8px 11px;
  border-radius:999px;
  background:rgba(255,255,255,.11);
  border:1px solid rgba(255,255,255,.16);
  font-size:.82rem;
  color:#eef7fc;
}

.stat-dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:#fff;
}

.meta{
  display:grid;
  grid-template-columns:1fr auto;
  gap:20px;
  align-items:end;
  margin-top:22px;
  position:relative;
  z-index:1;
}

.field label{
  display:block;
  font-size:.8rem;
  font-weight:700;
  margin-bottom:7px;
  color:#eaf3fa;
}

.field input{
  width:100%;
  max-width:440px;
  padding:12px 14px;
  border:1px solid rgba(255,255,255,.42);
  border-radius:10px;
  background:rgba(255,255,255,.11);
  color:#fff;
  font-size:1rem;
  outline:none;
}

.field input:focus{
  border-color:#fff;
  background:rgba(255,255,255,.16);
  box-shadow:0 0 0 3px rgba(255,255,255,.1);
}

.field input::placeholder{
  color:#d8e6f1;
}

.progress-wrap{
  text-align:right;
  font-size:.8rem;
  color:#e6f0f8;
  min-width:240px;
}

.progress{
  width:240px;
  height:9px;
  background:rgba(255,255,255,.18);
  border-radius:999px;
  overflow:hidden;
  margin-top:7px;
}

.progress span{
  display:block;
  height:100%;
  width:0;
  background:linear-gradient(90deg,#fff,#d8edf9);
  transition:.25s;
}

.instructions,
.section-card,
.results{
  background:#fff;
  border:1px solid var(--line);
  border-radius:18px;
  box-shadow:var(--shadow-sm);
}

.instructions{
  padding:20px 22px;
  margin:22px 0;
  display:grid;
  grid-template-columns:44px 1fr;
  gap:14px;
}

.info-icon{
  width:40px;
  height:40px;
  border-radius:11px;
  background:var(--pale);
  color:var(--blue);
  display:grid;
  place-items:center;
}

.info-icon svg{
  width:21px;
  height:21px;
  stroke:currentColor;
  fill:none;
  stroke-width:1.8;
}

.instructions strong{
  color:var(--navy);
}

.section-card{
  margin:18px 0;
  overflow:hidden;
  transition:.2s;
}

.section-card:hover{
  border-color:#c8d7e4;
  box-shadow:var(--shadow);
}

.section-head{
  padding:18px 20px;
  background:linear-gradient(180deg,#fcfdff,#f8fbfd);
  border-bottom:1px solid var(--line);
  display:flex;
  justify-content:space-between;
  gap:16px;
  align-items:center;
}

.section-title-wrap{
  display:flex;
  gap:12px;
  align-items:center;
}

.section-icon{
  width:38px;
  height:38px;
  border-radius:10px;
  background:var(--pale);
  color:var(--blue);
  display:grid;
  place-items:center;
}

.section-icon svg{
  width:20px;
  height:20px;
  stroke:currentColor;
  fill:none;
  stroke-width:1.8;
}

.section-kicker{
  font-size:.72rem;
  text-transform:uppercase;
  letter-spacing:.08em;
  font-weight:800;
  color:var(--blue);
}

.section-title{
  font-weight:800;
  color:var(--navy);
}

.counter{
  min-width:150px;
  text-align:center;
  padding:8px 12px;
  border-radius:999px;
  background:var(--pale);
  border:1px solid #dce9f4;
  font-weight:800;
  color:var(--navy);
  font-size:.88rem;
}

.counter.ok{
  background:#e9f7f0;
  border-color:#cdebdc;
  color:var(--good);
}

.counter.ok:before{
  content:"✓ ";
}

.statements{
  padding:7px 20px 14px;
}

.row{
  display:grid;
  grid-template-columns:50px 1fr minmax(250px,330px);
  gap:15px;
  align-items:center;
  padding:14px 0;
  border-bottom:1px solid #edf1f5;
}

.row:last-child{
  border-bottom:0;
}

.badge{
  width:42px;
  height:32px;
  border-radius:9px;
  background:#f0f5fa;
  border:1px solid #e1eaf1;
  display:grid;
  place-items:center;
  color:var(--blue);
  font-weight:800;
}

.statement{
  font-size:.96rem;
  color:#263548;
}

.slider-wrap{
  display:grid;
  grid-template-columns:1fr 40px;
  gap:10px;
  align-items:center;
}

.score-input{
  width:100%;
  accent-color:var(--blue);
  cursor:pointer;
}

.score-value{
  font-weight:900;
  color:var(--navy);
  text-align:center;
  background:var(--pale);
  border:1px solid #dce7f0;
  border-radius:9px;
  padding:6px 4px;
}

.actions{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin:24px 0;
}

.btn{
  display:inline-flex;
  align-items:center;
  gap:8px;
  border:0;
  border-radius:11px;
  padding:12px 17px;
  font-size:.94rem;
  font-weight:800;
  cursor:pointer;
}

.primary{
  background:var(--navy);
  color:#fff;
}

.secondary{
  background:#fff;
  color:var(--navy);
  border:1px solid var(--line);
}

.btn:disabled{
  opacity:.42;
  cursor:not-allowed;
}

.btn svg{
  width:17px;
  height:17px;
  stroke:currentColor;
  fill:none;
  stroke-width:2;
}

.message{
  margin:-7px 0 16px;
  color:var(--bad);
  font-weight:700;
  display:none;
}

.results{
  display:none;
  padding:26px;
  margin-top:24px;
}

.results-head{
  display:flex;
  align-items:center;
  gap:12px;
}

.results-icon{
  width:44px;
  height:44px;
  border-radius:12px;
  background:var(--pale);
  color:var(--blue);
  display:grid;
  place-items:center;
}

.results-icon svg{
  width:23px;
  height:23px;
  stroke:currentColor;
  fill:none;
  stroke-width:1.9;
}

.results h2{
  margin:0;
  color:var(--navy);
}

.results .lead{
  margin:7px 0 20px;
  color:var(--muted);
}

.top-role{
  background:linear-gradient(135deg,#eef5fb,#f8fbfe);
  border:1px solid #dbe8f2;
  padding:19px 20px;
  border-radius:14px;
  margin-bottom:20px;
}

.top-role .eyebrow{
  font-size:.73rem;
  text-transform:uppercase;
  letter-spacing:.09em;
  font-weight:800;
  color:var(--blue);
}

.top-role .name{
  font-size:1.5rem;
  font-weight:900;
  color:var(--navy);
}

.role-groups{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
  margin:20px 0;
}

.role-group{
  border:1px solid var(--line);
  border-radius:14px;
  overflow:hidden;
}

.role-group-head{
  padding:14px 16px;
  font-weight:900;
  color:var(--navy);
  background:#f8fbfd;
  border-bottom:1px solid var(--line);
}

.role-list{
  padding:8px 14px 12px;
}

.role-item{
  display:grid;
  grid-template-columns:1fr auto;
  gap:12px;
  align-items:center;
  padding:11px 2px;
  border-bottom:1px solid #edf1f5;
}

.role-item:last-child{
  border-bottom:0;
}

.role-name{
  font-weight:800;
}

.role-code{
  font-size:.78rem;
  color:var(--muted);
  font-weight:700;
}

.role-score{
  min-width:40px;
  text-align:center;
  font-weight:900;
  color:var(--navy);
  background:var(--pale);
  border:1px solid #dce7f0;
  border-radius:9px;
  padding:6px 7px;
}

.table-wrap{
  overflow:auto;
  border:1px solid var(--line);
  border-radius:12px;
}

table{
  width:100%;
  border-collapse:collapse;
}

th,td{
  text-align:left;
  padding:12px 11px;
  border-bottom:1px solid var(--line);
}

th{
  font-size:.75rem;
  text-transform:uppercase;
  color:var(--muted);
  background:#f8fafc;
}

td.score{
  font-weight:900;
  color:var(--navy);
}

.bar{
  height:10px;
  background:#edf2f6;
  border-radius:999px;
  overflow:hidden;
}

.bar span{
  display:block;
  height:100%;
  background:linear-gradient(90deg,var(--blue),var(--blue2));
}

.note{
  font-size:.87rem;
  color:var(--muted);
  margin-top:17px;
  padding:12px 14px;
  background:#fafcfd;
  border-left:3px solid #c8dce9;
  border-radius:8px;
}

.footer{
  margin-top:20px;
  color:var(--muted);
  font-size:.79rem;
  text-align:center;
}

@media(max-width:800px){
  .role-groups{
    grid-template-columns:1fr;
  }
}

@media(max-width:700px){
  .shell{
    padding:14px 10px 40px;
  }

  .hero{
    padding:24px 18px;
  }

  .meta{
    grid-template-columns:1fr;
  }

  .progress-wrap{
    text-align:left;
  }

  .progress{
    width:100%;
  }

  .section-head{
    align-items:flex-start;
    flex-direction:column;
  }

  .row{
    grid-template-columns:42px 1fr;
  }

  .slider-wrap{
    grid-column:2;
  }
}

@media print{
  body{
    background:#fff;
  }

  .hero,
  .instructions,
  .section-card,
  .actions,
  .message,
  .footer{
    display:none!important;
  }

  .results{
    display:block!important;
    box-shadow:none;
    border:0;
  }
}
</style>
</head>

<body>

<div class="shell">

<section class="hero">

<div class="hero-title">

<div class="hero-icon">
<svg viewBox="0 0 24 24">
<circle cx="8" cy="8" r="3"/>
<circle cx="16" cy="8" r="3"/>
<path d="M3.5 18c.7-3 2.3-4.5 4.5-4.5S11.8 15 12.5 18M11.5 18c.7-3 2.3-4.5 4.5-4.5S19.8 15 20.5 18"/>
</svg>
</div>

<div>
<h1>Belbin Team Roles Questionnaire</h1>
<p>
Allocate points to the statements that best describe you.
Your results will be calculated automatically after all seven sections are complete.
</p>
</div>

</div>

<div class="hero-stats">
<span class="stat-pill"><span class="stat-dot"></span>7 sections</span>
<span class="stat-pill"><span class="stat-dot"></span>10 points per section</span>
<span class="stat-pill"><span class="stat-dot"></span>9 team roles</span>
</div>

<div class="meta">

<div class="field">
<label for="participant">Participant name (optional)</label>
<input id="participant" placeholder="Enter your name">
</div>

<div class="progress-wrap">
<span id="progressText">0 of 7 sections complete</span>
<div class="progress">
<span id="progressBar"></span>
</div>
</div>

</div>

</section>

<section class="instructions">

<div class="info-icon">
<svg viewBox="0 0 24 24">
<circle cx="12" cy="12" r="9"/>
<path d="M12 10v6M12 7h.01"/>
</svg>
</div>

<div>
<strong>How to complete it</strong><br>
For each section, use the sliders to distribute <strong>exactly 10 points</strong>
across the nine statements. Give more points to statements that describe you
more accurately. The system will automatically prevent the section total from
exceeding 10 points.
</div>

</section>

<main id="questionnaire"></main>

<div class="actions">
<button class="btn primary" id="calculate" disabled>
Calculate my Belbin profile
</button>

<button class="btn secondary" id="reset">
Reset questionnaire
</button>
</div>

<div class="message" id="message">
Please make sure every section totals exactly 10 points.
</div>

<section class="results" id="results">

<div class="results-head">
<div class="results-icon">
<svg viewBox="0 0 24 24">
<path d="M4 19V9M10 19V5M16 19v-8M22 19V3"/>
</svg>
</div>

<div>
<h2>Your Belbin Team Role Profile</h2>
<p class="lead" id="resultLead"></p>
</div>
</div>

<div class="top-role">
<div class="eyebrow">Highest-scoring role</div>
<div class="name" id="topRole"></div>
</div>

<div class="role-groups">

<section class="role-group high">
<div class="role-group-head">
My three highest scoring team roles
</div>
<div class="role-list" id="highRoles"></div>
</section>

<section class="role-group middle">
<div class="role-group-head">
My three middle scoring team roles
</div>
<div class="role-list" id="middleRoles"></div>
</section>

<section class="role-group low">
<div class="role-group-head">
My three lowest scoring team roles
</div>
<div class="role-list" id="lowRoles"></div>
</section>

</div>

<div class="table-wrap">

<table>

<thead>
<tr>
<th>Rank</th>
<th>Role</th>
<th>Score</th>
<th>Profile</th>
</tr>
</thead>

<tbody id="resultsBody"></tbody>

</table>

</div>

<p class="note">
Your highest three scores indicate your strongest preferred team-role
tendencies. Your middle three are roles you may draw on when needed,
while your lowest three are likely to be less natural preferences.
</p>

<div class="actions">
<button class="btn primary" id="printBtn">
Print / Save results
</button>

<button class="btn secondary" id="csvBtn">
Download results (CSV)
</button>
</div>

</section>

<div class="footer">
Question wording and scoring key are based on the supplied Belbin Team Roles questionnaire.
</div>

</div>

<script>

