name:"Teamworker",
items:[11,26,34,40,52,62,78]
},
{
code:"RI",
name:"Resource Investigator",
items:[10,23,35,47,54,68,73]
},
{
code:"CF",
name:"Completer Finisher",
items:[14,28,31,46,56,64,72]
},
{
code:"SP",
name:"Specialist",
items:[15,22,36,41,58,60,77]
}
];

const answers=Object.fromEntries(
sections.flatMap(
s=>s.items.map(i=>[i.code,0])
)
);

function validateConfiguration(){

const questionnaireCodes=
sections.flatMap(s=>s.items.map(i=>i.code));

const mappedCodes=
roles.flatMap(r=>r.items);

const uniqueQuestionnaire=
new Set(questionnaireCodes);

const uniqueMapped=
new Set(mappedCodes);

const validSections=
sections.length===7 &&
sections.every(s=>s.items.length===9);

const validMapping=
questionnaireCodes.length===63 &&
mappedCodes.length===63 &&
uniqueQuestionnaire.size===63 &&
uniqueMapped.size===63 &&
questionnaireCodes.every(
c=>uniqueMapped.has(c)
);

if(!validSections || !validMapping){
throw new Error(
"Questionnaire scoring configuration failed validation."
);
}

}

validateConfiguration();

const q=
document.getElementById("questionnaire");

const calcBtn=
document.getElementById("calculate");

const msg=
document.getElementById("message");

function renderQuestionnaire(){

q.innerHTML=
sections.map(s=>`

<section class="section-card" id="section-${s.id}">

<div class="section-head">

<div class="section-title-wrap">

<div class="section-icon">
<svg viewBox="0 0 24 24">
<path d="M5 5h14M5 12h14M5 19h9"/>
</svg>
</div>

<div>
<div class="section-kicker">
Section ${s.id}
</div>

<div class="section-title">
${escapeHtml(s.title)}
</div>
</div>

</div>

<div class="counter" id="counter-${s.id}">
0 / 10 points
</div>

</div>

<div class="statements">

${s.items.map(i=>`

<div class="row">

<div class="badge">
${i.code}
</div>

<label
class="statement"
for="score-${i.code}">
${escapeHtml(i.text)}
</label>

<div class="slider-wrap">

<input
class="score-input"
id="score-${i.code}"
type="range"
min="0"
max="10"
step="1"
value="0"
data-code="${i.code}"
data-section="${s.id}">

<span
class="score-value"
id="value-${i.code}">
0
</span>

</div>

</div>

`).join("")}

</div>

</section>

`).join("");

document
.querySelectorAll(".score-input")
.forEach(el=>{

el.addEventListener("input",e=>{

const code=
Number(e.target.dataset.code);

const sectionId=
e.target.dataset.section;

const section=
sections.find(
s=>s.id===sectionId
);

const requested=
Number(e.target.value)||0;

const otherTotal=
section.items.reduce(
(sum,i)=>
sum+
(
i.code===code
?
0
:
answers[i.code]||0
),
0
);

const allowed=
Math.max(
0,
10-otherTotal
);

const val=
Math.min(
requested,
allowed
);

answers[code]=val;

e.target.value=val;

document
.getElementById(
`value-${code}`
)
.textContent=val;

updateSliderLimits(sectionId);

updateStatus();

});

});

updateStatus();

}

function escapeHtml(s){

return String(s)
.replace(
/[&<>'"]/g,
c=>({
"&":"&amp;",
"<":"&lt;",
">":"&gt;",
"'":"&#39;",
'"':"&quot;"
}[c])
);

}

function sectionTotal(s){

return s.items.reduce(
(sum,i)=>
sum+(answers[i.code]||0),
0
);

}

function updateSliderLimits(sectionId){

const section=
sections.find(
s=>s.id===sectionId
);

const total=
sectionTotal(section);

section.items.forEach(i=>{

const slider=
document.getElementById(
`score-${i.code}`
);

const current=
answers[i.code]||0;

const otherTotal=
total-current;

slider.max=
Math.max(
current,
10-otherTotal
);

});

}

function updateStatus(){

let complete=0;

sections.forEach(s=>{

const total=
sectionTotal(s);

const el=
document.getElementById(
`counter-${s.id}`
);

el.textContent=
`${total} / 10 points`;

el.classList.toggle(
"ok",
total===10
);

updateSliderLimits(s.id);

if(total===10){
complete++;
}

});

document
.getElementById("progressText")
.textContent=
`${complete} of 7 sections complete`;

document
.getElementById("progressBar")
.style.width=
`${complete/7*100}%`;

calcBtn.disabled=
complete!==7;

if(complete===7){
msg.style.display="none";
}

}

function calculate(){

if(
sections.some(
s=>sectionTotal(s)!==10
)
){

msg.style.display="block";
return;

}

const scored=
roles.map(r=>({

code:r.code,

name:r.name,

score:
r.items.reduce(
(sum,c)=>
sum+(answers[c]||0),
0
)

}))
.sort(
(a,b)=>
b.score-a.score ||
a.name.localeCompare(b.name)
);

const reconciledTotal=
scored.reduce(
(sum,r)=>sum+r.score,
0
);

if(reconciledTotal!==70){

msg.textContent=
"A scoring validation error was detected. Please reset the questionnaire and try again.";

msg.style.display="block";

return;

}

let lastScore=null;
let lastRank=0;

scored.forEach(
(r,index)=>{

if(r.score!==lastScore){

lastRank=index+1;
lastScore=r.score;

}

r.rank=lastRank;

}
);

const name=
document
.getElementById("participant")
.value
.trim();

document
.getElementById("resultLead")
.textContent=
name
?
`${name}, your scores are shown below.`
:
"Your scores are shown below.";

const leaders=
scored.filter(
r=>r.score===scored[0].score
);

document
.getElementById("topRole")
.textContent=
leaders
.map(
r=>`${r.name} (${r.code})`
)
.join(" / ")
+
` — ${scored[0].score} points`;

const max=
Math.max(
...scored.map(r=>r.score),
1
);

const renderGroup=
items=>
items.map(
r=>`

<div class="role-item">

<div>

<div class="role-name">
${escapeHtml(r.name)}
</div>

<div class="role-code">
${r.code}
</div>

</div>

<div class="role-score">
${r.score}
</div>

</div>

`
).join("");

document
.getElementById("highRoles")
.innerHTML=
renderGroup(
scored.slice(0,3)
);

document
.getElementById("middleRoles")
.innerHTML=
renderGroup(
scored.slice(3,6)
);

document
.getElementById("lowRoles")
.innerHTML=
renderGroup(
scored.slice(6,9)
);

document
.getElementById("resultsBody")
.innerHTML=
scored.map(
r=>`

<tr>

<td>
${r.rank}
</td>

<td>
<strong>
${escapeHtml(r.name)}
</strong>
(${r.code})
</td>

<td class="score">
${r.score}
</td>

<td>

<div class="bar">
<span
style="width:${r.score/max*100}%">
</span>
</div>

</td>

</tr>

`
).join("");

document
.getElementById("results")
.style.display=
"block";

document
.getElementById("results")
.scrollIntoView({
behavior:"smooth",
block:"start"
});

window.currentResults=scored;

}

function resetAll(){

document
.querySelectorAll(".score-input")
.forEach(el=>{

el.value=0;

document
.getElementById(
`value-${el.dataset.code}`
)
.textContent="0";

el.max=10;

});

Object
.keys(answers)
.forEach(
k=>answers[k]=0
);

document
.getElementById("participant")
.value="";

document
.getElementById("results")
.style.display="none";

msg.style.display="none";

updateStatus();

window.scrollTo({
top:0,
behavior:"smooth"
});

}

function downloadCSV(){

const name=
document
.getElementById("participant")
.value
.trim();

const rows=[
[
"Participant",
"Rank",
"Role Code",
"Team Role",
"Score"
],

...window.currentResults.map(
r=>[
name,
r.rank,
r.code,
r.name,
r.score
]
)
];

const csv=
rows.map(
row=>
row.map(
v=>
'"'+
String(v)
.replace(/"/g,'""')
+'"'
)
.join(",")
)
.join("\r\n");

const blob=
new Blob(
["\ufeff"+csv],
{
type:"text/csv;charset=utf-8"
}
);

const a=
document.createElement("a");

a.href=
URL.createObjectURL(blob);

a.download=
"belbin-results.csv";

document.body.appendChild(a);

a.click();

a.remove();

URL.revokeObjectURL(a.href);

}

calcBtn.addEventListener(
"click",
calculate
);

document
.getElementById("reset")
.addEventListener(
"click",
resetAll
);

document
.getElementById("printBtn")
.addEventListener(
"click",
()=>window.print()
);

document
.getElementById("csvBtn")
.addEventListener(
"click",
downloadCSV
);

renderQuestionnaire();

</script>

</body>
</html>
